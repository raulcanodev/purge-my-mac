#!/usr/bin/env bash

# purge-my-mac — reclaim space used by development tools on macOS.

set -u
set -o pipefail

VERSION="1.3.0"
DRY_RUN=false
COLOR=true
DATA_VOLUME="/System/Volumes/Data"

# macOS keeps writable user data on its Data volume.
[[ -d "$DATA_VOLUME" ]] || DATA_VOLUME="/"
[[ -n "${NO_COLOR:-}" || ! -t 1 ]] && COLOR=false

usage() {
  cat <<EOF
purge-my-mac ${VERSION} — clean development caches on macOS

Usage:
  purge-my-mac [options]

Options:
  -n, --dry-run    Preview the cleanup without deleting anything
      --no-color   Disable colors and animations
  -h, --help       Show this help
  -v, --version    Show the version
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--dry-run) DRY_RUN=true ;;
    --no-color) COLOR=false ;;
    -h|--help) usage; exit 0 ;;
    -v|--version) printf '%s\n' "$VERSION"; exit 0 ;;
    *) printf 'Error: unknown option: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if $COLOR; then
  RESET=$'\033[0m'
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  CYAN=$'\033[36m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  RED=$'\033[31m'
else
  RESET="" BOLD="" DIM="" CYAN="" GREEN="" YELLOW="" RED=""
fi

TMP_LOG=""
CURSOR_HIDDEN=false

# Always leave the terminal usable after an interruption.
finish() {
  if $CURSOR_HIDDEN; then printf '\033[?25h'; fi
  [[ -z "$TMP_LOG" ]] || rm -f "$TMP_LOG"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ "$(uname -s)" != "Darwin" ]]; then
  printf '%spurge-my-mac is built for macOS.%s\n' "$RED" "$RESET" >&2
  exit 1
fi

free_gib() {
  df -Pk "$DATA_VOLUME" 2>/dev/null | awk 'NR==2 { printf "%.1f", $4/1024/1024 }'
}

line() {
  printf '%s\n' "${DIM}────────────────────────────────────────${RESET}"
}

section() {
  printf '\n%s%s  %s%s\n' "$BOLD" "$1" "$2" "$RESET"
}

skip_step() {
  printf '  %s○%s %s %s(not installed)%s\n' "$DIM" "$RESET" "$1" "$DIM" "$RESET"
}

show_log_tail() {
  [[ -s "$TMP_LOG" ]] || return 0
  tail -n 4 "$TMP_LOG" | sed 's/^/      /'
}

run_step() {
  local label="$1"
  local status=0
  local pid frame i
  shift

  if $DRY_RUN; then
    printf '  %s◇%s %s %s(preview)%s\n' "$CYAN" "$RESET" "$label" "$DIM" "$RESET"
    return 0
  fi

  # Keep noisy tool output hidden unless a step fails.
  TMP_LOG=$(mktemp "${TMPDIR:-/tmp}/purge-my-mac.XXXXXX") || return 1

  # Animate only when the output is an interactive terminal.
  if [[ -t 1 ]] && $COLOR; then
    "$@" >"$TMP_LOG" 2>&1 &
    pid=$!
    CURSOR_HIDDEN=true
    printf '\033[?25l'
    i=0
    while kill -0 "$pid" 2>/dev/null; do
      case $((i % 8)) in
        0) frame='⠋' ;; 1) frame='⠙' ;; 2) frame='⠹' ;; 3) frame='⠸' ;;
        4) frame='⠼' ;; 5) frame='⠴' ;; 6) frame='⠦' ;; *) frame='⠧' ;;
      esac
      printf '\r  %s%s%s %s' "$CYAN" "$frame" "$RESET" "$label"
      i=$((i + 1))
      sleep 0.08
    done
    wait "$pid" || status=$?
    printf '\r\033[2K'
    printf '\033[?25h'
    CURSOR_HIDDEN=false
  else
    "$@" >"$TMP_LOG" 2>&1 || status=$?
  fi

  if [[ $status -eq 0 ]]; then
    printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$label"
  else
    printf '  %s!%s %s %s(could not complete)%s\n' "$YELLOW" "$RESET" "$label" "$DIM" "$RESET"
    show_log_tail
  fi

  rm -f "$TMP_LOG"
  TMP_LOG=""
  return 0
}

remove_paths() {
  local label="$1"
  local path
  shift
  local existing=()

  # Skip missing paths instead of reporting empty cleanup work.
  for path in "$@"; do
    if [[ -e "$path" ]]; then existing+=("$path"); fi
  done

  if [[ ${#existing[@]} -eq 0 ]]; then
    printf '  %s○%s %s %s(already clean)%s\n' "$DIM" "$RESET" "$label" "$DIM" "$RESET"
    return 0
  fi

  run_step "$label" rm -rf -- "${existing[@]}"
}

any_path_exists() {
  local path
  for path in "$@"; do
    if [[ -e "$path" ]]; then return 0; fi
  done
  return 1
}

directory_has_entries() {
  local directory="$1"
  [[ -d "$directory" ]] || return 1
  find "$directory" -mindepth 1 -print -quit 2>/dev/null | grep -q .
}

path_size() {
  du -sh "$1" 2>/dev/null | awk 'NR==1 { print $1 }'
}

ask_yes_no() {
  local prompt="$1"
  local answer

  # Prompt through the terminal even when stdin is redirected.
  if ! { : </dev/tty; } 2>/dev/null; then
    printf '  %s○%s Interactive cleanup skipped %s(no terminal available)%s\n' \
      "$DIM" "$RESET" "$DIM" "$RESET"
    return 1
  fi

  while true; do
    printf '  %s%s%s [y/N] ' "$BOLD" "$prompt" "$RESET" >/dev/tty
    if ! IFS= read -r answer </dev/tty; then return 1; fi

    case "$answer" in
      y|Y|yes|Yes|YES) return 0 ;;
      ""|n|N|no|No|NO) return 1 ;;
      *) printf '  Please answer yes or no.\n' >/dev/tty ;;
    esac
  done
}

quit_macos_app() {
  local app_name="$1"
  local process_name="$2"
  local i=0

  if ! pgrep -x "$process_name" >/dev/null 2>&1; then return 0; fi

  printf '  %s◇%s Closing %s...\n' "$CYAN" "$RESET" "$app_name"
  if ! osascript -e "tell application \"$app_name\" to quit" >/dev/null 2>&1; then
    printf '  %s!%s Could not ask %s to quit. Cleanup skipped.\n' \
      "$YELLOW" "$RESET" "$app_name"
    return 1
  fi

  # Give the app five seconds to exit cleanly.
  while pgrep -x "$process_name" >/dev/null 2>&1; do
    if [[ $i -ge 20 ]]; then
      printf '  %s!%s %s is still running. Cleanup skipped to protect its data.\n' \
        "$YELLOW" "$RESET" "$app_name"
      return 1
    fi
    sleep 0.25
    i=$((i + 1))
  done

  printf '  %s✓%s %s closed\n' "$GREEN" "$RESET" "$app_name"
}

codex_is_running() {
  pgrep -x 'Codex' >/dev/null 2>&1 || pgrep -x 'codex' >/dev/null 2>&1
}

prepare_codex_cleanup() {
  if pgrep -x 'Codex' >/dev/null 2>&1; then
    quit_macos_app 'Codex' 'Codex' || return 1
  fi

  if pgrep -x 'codex' >/dev/null 2>&1; then
    printf '  %s!%s Codex CLI is still running. Cleanup skipped to protect its data.\n' \
      "$YELLOW" "$RESET"
    return 1
  fi
}

has_cursor_transcripts() {
  local root="$HOME/.cursor/projects"

  [[ -d "$root" ]] || return 1
  find "$root" -type d -name 'agent-transcripts' -print -quit 2>/dev/null | grep -q .
}

clean_cursor_transcripts() {
  local root="$HOME/.cursor/projects"

  [[ -d "$root" ]] || return 0
  # Remove transcript folders without touching project files.
  find "$root" -type d -name 'agent-transcripts' -prune -exec rm -rf -- {} \;
}

BEFORE=$(free_gib)

printf '\n%s%s purge-my-mac%s  %smacOS development cleanup%s\n' "$BOLD" "$CYAN" "$RESET" "$DIM" "$RESET"
line
printf '  Free space  %s%s GiB%s\n' "$BOLD" "$BEFORE" "$RESET"
$DRY_RUN && printf '  Run         %spreview%s\n' "$CYAN" "$RESET"

section '🐳' 'Docker'
if command -v docker >/dev/null 2>&1; then
  if docker info >/dev/null 2>&1; then
    run_step 'Build cache' docker builder prune -a -f
    run_step 'Unused images' docker image prune -a -f
  else
    printf '  %s○%s Docker is not running\n' "$DIM" "$RESET"
  fi
else
  skip_step 'Docker'
fi

section '📦' 'JavaScript'
if command -v pnpm >/dev/null 2>&1; then
  run_step 'pnpm store' pnpm store prune
else
  skip_step 'pnpm'
fi

if command -v npm >/dev/null 2>&1; then
  run_step 'npm cache' npm cache clean --force
  remove_paths 'npx temporary files and logs' "$HOME/.npm/_npx" "$HOME/.npm/_logs"
else
  skip_step 'npm'
fi

if command -v yarn >/dev/null 2>&1; then
  run_step 'Yarn cache' yarn cache clean
else
  skip_step 'Yarn'
fi

section '🍺' 'Homebrew'
if command -v brew >/dev/null 2>&1; then
  run_step 'Old versions and downloads' brew cleanup -s
else
  skip_step 'Homebrew'
fi

section '🐍' 'Python'
if command -v python3 >/dev/null 2>&1 && python3 -m pip --version >/dev/null 2>&1; then
  run_step 'pip cache' python3 -m pip cache purge
elif command -v pip >/dev/null 2>&1; then
  run_step 'pip cache' pip cache purge
else
  skip_step 'pip'
fi

section '🔥' 'Tools and applications'
remove_paths 'Tool stores and caches' \
  "$HOME/Library/pnpm/store" \
  "$HOME/Library/Caches/pnpm" \
  "$HOME/Library/Caches/Yarn" \
  "$HOME/Library/Caches/typescript" \
  "$HOME/Library/Caches/Cypress" \
  "$HOME/Library/Caches/ms-playwright" \
  "$HOME/Library/Caches/ms-playwright-go" \
  "$HOME/Library/Caches/electron" \
  "$HOME/Library/Caches/CocoaPods" \
  "$HOME/Library/Caches/pip" \
  "$HOME/Library/Caches/Homebrew"

remove_paths 'Xcode DerivedData' "$HOME/Library/Developer/Xcode/DerivedData"

CODE_DIR="$HOME/Library/Application Support/Code"
if [[ -d "$CODE_DIR" ]]; then
  remove_paths 'VS Code caches' \
    "$CODE_DIR/Cache" \
    "$CODE_DIR/CachedData" \
    "$CODE_DIR/Code Cache" \
    "$CODE_DIR/GPUCache" \
    "$CODE_DIR/DawnGraphiteCache" \
    "$CODE_DIR/DawnWebGPUCache" \
    "$CODE_DIR/Crashpad" \
    "$CODE_DIR/logs" \
    "$CODE_DIR/Service Worker/CacheStorage"
  printf '  %sSettings, keybindings, extensions, and chats are preserved.%s\n' "$DIM" "$RESET"
else
  skip_step 'VS Code'
fi

CURSOR_DIR="$HOME/Library/Application Support/Cursor"
if [[ -d "$CURSOR_DIR" ]]; then
  remove_paths 'Cursor caches' \
    "$CURSOR_DIR/Cache" \
    "$CURSOR_DIR/CachedData" \
    "$CURSOR_DIR/Code Cache" \
    "$CURSOR_DIR/GPUCache" \
    "$CURSOR_DIR/DawnGraphiteCache" \
    "$CURSOR_DIR/DawnWebGPUCache" \
    "$CURSOR_DIR/Crashpad" \
    "$CURSOR_DIR/logs" \
    "$CURSOR_DIR/Service Worker/CacheStorage"
  printf '  %sSettings, keybindings, extensions, and chats are preserved.%s\n' "$DIM" "$RESET"
else
  skip_step 'Cursor'
fi

CODEX_DATA_DIR="${CODEX_HOME:-$HOME/.codex}"
CODEX_TEMP_DIR="$CODEX_DATA_DIR/.tmp"
CODEX_CACHE_DIR="$CODEX_DATA_DIR/cache"
CODEX_CACHE_PATHS=(
  "$CODEX_TEMP_DIR"
  "$CODEX_CACHE_DIR"
)

if any_path_exists "${CODEX_CACHE_PATHS[@]}"; then
  if codex_is_running; then
    printf '  %s○%s Codex temporary files and cache %s(Codex is running)%s\n' \
      "$DIM" "$RESET" "$DIM" "$RESET"
  else
    if [[ -e "$CODEX_TEMP_DIR" ]]; then
      CODEX_TEMP_SIZE=$(path_size "$CODEX_TEMP_DIR")
      remove_paths "Codex temporary files · ${CODEX_TEMP_SIZE:-unknown size}" "$CODEX_TEMP_DIR"
    fi
    if [[ -e "$CODEX_CACHE_DIR" ]]; then
      CODEX_CACHE_SIZE=$(path_size "$CODEX_CACHE_DIR")
      remove_paths "Codex cache · ${CODEX_CACHE_SIZE:-unknown size}" "$CODEX_CACHE_DIR"
    fi
  fi
else
  printf '  %s○%s Codex temporary files and cache %s(already clean)%s\n' \
    "$DIM" "$RESET" "$DIM" "$RESET"
fi
printf '  %sActive sessions, plugins, logs, settings, and authentication are preserved.%s\n' \
  "$DIM" "$RESET"

section '💬' 'Optional history cleanup'

CODEX_ARCHIVED_SESSIONS="$CODEX_DATA_DIR/archived_sessions"
if directory_has_entries "$CODEX_ARCHIVED_SESSIONS"; then
  CODEX_ARCHIVE_SIZE=$(path_size "$CODEX_ARCHIVED_SESSIONS")
  printf '\n  %sCodex archived sessions%s  %s%s%s\n' \
    "$BOLD" "$RESET" "$CYAN" "${CODEX_ARCHIVE_SIZE:-unknown size}" "$RESET"
  printf '  %sThis permanently removes locally archived Codex sessions.%s\n' \
    "$YELLOW" "$RESET"
  printf '  %sActive sessions, configuration, plugins, logs, and authentication are preserved.%s\n' \
    "$DIM" "$RESET"

  if $DRY_RUN; then
    printf '  %s◇%s Would ask whether to remove archived Codex sessions\n' "$CYAN" "$RESET"
  elif ask_yes_no 'Delete all locally archived Codex sessions?'; then
    if prepare_codex_cleanup; then
      remove_paths 'Codex archived sessions' "$CODEX_ARCHIVED_SESSIONS"
    fi
  else
    printf '  %s○%s Codex archived sessions preserved\n' "$DIM" "$RESET"
  fi
else
  printf '  %s○%s Codex archived sessions %s(already clean)%s\n' \
    "$DIM" "$RESET" "$DIM" "$RESET"
fi

CURSOR_STATE_DIR="$CURSOR_DIR/User/globalStorage"
CURSOR_CHAT_PATHS=(
  "$CURSOR_STATE_DIR/state.vscdb"
  "$CURSOR_STATE_DIR/state.vscdb-wal"
  "$CURSOR_STATE_DIR/state.vscdb-shm"
  "$CURSOR_STATE_DIR/state.vscdb.backup"
  "$CURSOR_STATE_DIR/conversation-search.db"
  "$CURSOR_STATE_DIR/conversation-search.db-wal"
  "$CURSOR_STATE_DIR/conversation-search.db-shm"
  "$CURSOR_DIR/User/workspaceStorage"
)

CURSOR_HAS_CHAT_DATA=false
for path in "${CURSOR_CHAT_PATHS[@]}"; do
  if [[ -e "$path" ]]; then
    CURSOR_HAS_CHAT_DATA=true
    break
  fi
done
if has_cursor_transcripts; then CURSOR_HAS_CHAT_DATA=true; fi

if $CURSOR_HAS_CHAT_DATA; then
  printf '\n  %sCursor chat cleanup%s\n' "$BOLD" "$RESET"
  printf '  %sThis permanently removes local Cursor chat/agent history and workspace state.%s\n' \
    "$YELLOW" "$RESET"
  printf '  %sSettings, keybindings, and extensions are preserved.%s\n' "$DIM" "$RESET"

  if $DRY_RUN; then
    printf '  %s◇%s Would ask whether to remove Cursor chat history\n' "$CYAN" "$RESET"
  elif ask_yes_no 'Delete all local Cursor chats and agent history?'; then
    if quit_macos_app 'Cursor' 'Cursor'; then
      remove_paths 'Cursor chat and workspace databases' "${CURSOR_CHAT_PATHS[@]}"
      if has_cursor_transcripts; then
        run_step 'Cursor agent transcripts' clean_cursor_transcripts
      fi
    fi
  else
    printf '  %s○%s Cursor chats preserved\n' "$DIM" "$RESET"
  fi
else
  printf '  %s○%s Cursor chats %s(already clean)%s\n' "$DIM" "$RESET" "$DIM" "$RESET"
fi

VSCODE_WORKSPACE_STORAGE="$CODE_DIR/User/workspaceStorage"
VSCODE_GLOBAL_STATE="$CODE_DIR/User/globalStorage/state.vscdb"
if [[ -e "$VSCODE_WORKSPACE_STORAGE" ]]; then
  printf '\n  %sVS Code chat cleanup%s\n' "$BOLD" "$RESET"
  printf '  %sThis removes local chat history and workspace state stored by VS Code.%s\n' \
    "$YELLOW" "$RESET"
  printf '  %sSettings, keybindings, and extensions are preserved.%s\n' "$DIM" "$RESET"

  if $DRY_RUN; then
    printf '  %s◇%s Would ask whether to remove VS Code chat/workspace history\n' \
      "$CYAN" "$RESET"
  elif ask_yes_no 'Delete local VS Code chat and workspace history?'; then
    if quit_macos_app 'Visual Studio Code' 'Code'; then
      remove_paths 'VS Code chat and workspace state' "$VSCODE_WORKSPACE_STORAGE"
    fi
  else
    printf '  %s○%s VS Code chats preserved\n' "$DIM" "$RESET"
  fi
elif [[ -e "$VSCODE_GLOBAL_STATE" ]]; then
  printf '  %s○%s VS Code workspace chats %s(not found)%s\n' \
    "$DIM" "$RESET" "$DIM" "$RESET"
  printf '  %sGlobal VS Code state is preserved because it may contain unrelated data.%s\n' \
    "$DIM" "$RESET"
else
  printf '  %s○%s VS Code chats %s(already clean)%s\n' "$DIM" "$RESET" "$DIM" "$RESET"
fi

AFTER=$(free_gib)
# Free space can fluctuate while the script runs; never report a negative result.
RECOVERED=$(awk -v after="$AFTER" -v before="$BEFORE" 'BEGIN {
  difference=after-before
  if (difference < 0) difference=0
  printf "%.1f", difference
}')

printf '\n'
line
if $DRY_RUN; then
  printf '%s◇ Preview complete%s — no files were removed.\n\n' "$CYAN" "$RESET"
else
  printf '%s✓ Cleanup complete%s\n\n' "$GREEN" "$RESET"
  printf '  Before     %s GiB free\n' "$BEFORE"
  printf '  After      %s GiB free\n' "$AFTER"
  printf '  Reclaimed  %s%s GiB%s\n\n' "$BOLD" "$RECOVERED" "$RESET"
fi
