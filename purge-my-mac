#!/usr/bin/env bash

# purge-my-mac — recupera espacio ocupado por herramientas de desarrollo en macOS.

set -u
set -o pipefail

VERSION="1.0.0"
DEEP=false
DRY_RUN=false
ASSUME_YES=false
COLOR=true
DATA_VOLUME="/System/Volumes/Data"

[[ -d "$DATA_VOLUME" ]] || DATA_VOLUME="/"
[[ -n "${NO_COLOR:-}" || ! -t 1 ]] && COLOR=false

usage() {
  cat <<EOF
purge-my-mac ${VERSION} — limpia cachés de desarrollo en macOS

Uso:
  purge-my-mac [opciones]

Opciones:
  -d, --deep       Incluye Xcode, VS Code y cachés de aplicaciones
  -n, --dry-run    Muestra la limpieza sin borrar nada
  -y, --yes        Omite la confirmación de --deep
      --no-color   Desactiva colores y animaciones
  -h, --help       Muestra esta ayuda
  -v, --version    Muestra la versión
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--deep) DEEP=true ;;
    -n|--dry-run) DRY_RUN=true ;;
    -y|--yes) ASSUME_YES=true ;;
    --no-color) COLOR=false ;;
    -h|--help) usage; exit 0 ;;
    -v|--version) printf '%s\n' "$VERSION"; exit 0 ;;
    *) printf 'Error: opción desconocida: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if $COLOR; then
  RESET=$'\033[0m'
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  CYAN=$'\033[36m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  RED=$'\033[31m'
else
  RESET="" BOLD="" DIM="" CYAN="" GREEN="" YELLOW="" RED=""
fi

TMP_LOG=""
CURSOR_HIDDEN=false

finish() {
  if $CURSOR_HIDDEN; then printf '\033[?25h'; fi
  [[ -z "$TMP_LOG" ]] || rm -f "$TMP_LOG"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ "$(uname -s)" != "Darwin" ]]; then
  printf '%spurge-my-mac está diseñado para macOS.%s\n' "$RED" "$RESET" >&2
  exit 1
fi

free_gib() {
  df -Pk "$DATA_VOLUME" 2>/dev/null | awk 'NR==2 { printf "%.1f", $4/1024/1024 }'
}

line() {
  printf '%s\n' "${DIM}────────────────────────────────────────${RESET}"
}

section() {
  printf '\n%s%s  %s%s\n' "$BOLD" "$1" "$2" "$RESET"
}

skip_step() {
  printf '  %s○%s %s %s(no instalado)%s\n' "$DIM" "$RESET" "$1" "$DIM" "$RESET"
}

show_log_tail() {
  [[ -s "$TMP_LOG" ]] || return 0
  tail -n 4 "$TMP_LOG" | sed 's/^/      /'
}

run_step() {
  local label="$1"
  local status=0
  local pid frame i
  shift

  if $DRY_RUN; then
    printf '  %s◇%s %s %s(simulación)%s\n' "$CYAN" "$RESET" "$label" "$DIM" "$RESET"
    return 0
  fi

  TMP_LOG=$(mktemp "${TMPDIR:-/tmp}/purge-my-mac.XXXXXX") || return 1

  if [[ -t 1 ]] && $COLOR; then
    "$@" >"$TMP_LOG" 2>&1 &
    pid=$!
    CURSOR_HIDDEN=true
    printf '\033[?25l'
    i=0
    while kill -0 "$pid" 2>/dev/null; do
      case $((i % 8)) in
        0) frame='⠋' ;; 1) frame='⠙' ;; 2) frame='⠹' ;; 3) frame='⠸' ;;
        4) frame='⠼' ;; 5) frame='⠴' ;; 6) frame='⠦' ;; *) frame='⠧' ;;
      esac
      printf '\r  %s%s%s %s' "$CYAN" "$frame" "$RESET" "$label"
      i=$((i + 1))
      sleep 0.08
    done
    wait "$pid" || status=$?
    printf '\r\033[2K'
    printf '\033[?25h'
    CURSOR_HIDDEN=false
  else
    "$@" >"$TMP_LOG" 2>&1 || status=$?
  fi

  if [[ $status -eq 0 ]]; then
    printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$label"
  else
    printf '  %s!%s %s %s(no se pudo completar)%s\n' "$YELLOW" "$RESET" "$label" "$DIM" "$RESET"
    show_log_tail
  fi

  rm -f "$TMP_LOG"
  TMP_LOG=""
  return 0
}

remove_paths() {
  local label="$1"
  local path
  shift
  local existing=()

  for path in "$@"; do
    if [[ -e "$path" ]]; then existing+=("$path"); fi
  done

  if [[ ${#existing[@]} -eq 0 ]]; then
    printf '  %s○%s %s %s(ya está limpio)%s\n' "$DIM" "$RESET" "$label" "$DIM" "$RESET"
    return 0
  fi

  run_step "$label" rm -rf -- "${existing[@]}"
}

confirm_deep() {
  $DEEP || return 0
  $DRY_RUN && return 0
  $ASSUME_YES && return 0

  if [[ ! -t 0 ]]; then
    printf '%sEl modo deep requiere confirmación. Usa --deep --yes.%s\n' "$YELLOW" "$RESET" >&2
    exit 1
  fi

  printf '%sEl modo deep eliminará cachés regenerables de Xcode, VS Code y otras herramientas.%s\n' "$YELLOW" "$RESET"
  printf '¿Continuar? [y/N] '
  read -r answer
  case "$answer" in y|Y|yes|YES|sí|SI|Sí) ;; *) printf 'Cancelado.\n'; exit 0 ;; esac
}

confirm_deep

BEFORE=$(free_gib)

printf '\n%s%s purge-my-mac%s  %slimpieza de desarrollo para macOS%s\n' "$BOLD" "$CYAN" "$RESET" "$DIM" "$RESET"
line
printf '  Espacio libre  %s%s GiB%s\n' "$BOLD" "$BEFORE" "$RESET"
$DEEP && printf '  Modo           %sDEEP%s\n' "$RED" "$RESET"
$DRY_RUN && printf '  Ejecución      %ssimulación%s\n' "$CYAN" "$RESET"

section '🐳' 'Docker'
if command -v docker >/dev/null 2>&1; then
  if docker info >/dev/null 2>&1; then
    run_step 'Build cache' docker builder prune -a -f
    run_step 'Imágenes sin usar' docker image prune -a -f
  else
    printf '  %s○%s Docker no está ejecutándose\n' "$DIM" "$RESET"
  fi
else
  skip_step 'Docker'
fi

section '📦' 'JavaScript'
if command -v pnpm >/dev/null 2>&1; then
  run_step 'Store de pnpm' pnpm store prune
else
  skip_step 'pnpm'
fi

if command -v npm >/dev/null 2>&1; then
  run_step 'Caché de npm' npm cache clean --force
  remove_paths 'Temporales y logs de npx' "$HOME/.npm/_npx" "$HOME/.npm/_logs"
else
  skip_step 'npm'
fi

if command -v yarn >/dev/null 2>&1; then
  run_step 'Caché de Yarn' yarn cache clean
else
  skip_step 'Yarn'
fi

section '🍺' 'Homebrew'
if command -v brew >/dev/null 2>&1; then
  run_step 'Versiones y descargas antiguas' brew cleanup -s
else
  skip_step 'Homebrew'
fi

section '🐍' 'Python'
if command -v python3 >/dev/null 2>&1 && python3 -m pip --version >/dev/null 2>&1; then
  run_step 'Caché de pip' python3 -m pip cache purge
elif command -v pip >/dev/null 2>&1; then
  run_step 'Caché de pip' pip cache purge
else
  skip_step 'pip'
fi

if $DEEP; then
  section '🔥' 'Limpieza deep'
  remove_paths 'Stores y cachés de herramientas' \
    "$HOME/Library/pnpm/store" \
    "$HOME/Library/Caches/pnpm" \
    "$HOME/Library/Caches/Yarn" \
    "$HOME/Library/Caches/typescript" \
    "$HOME/Library/Caches/Cypress" \
    "$HOME/Library/Caches/ms-playwright" \
    "$HOME/Library/Caches/ms-playwright-go" \
    "$HOME/Library/Caches/electron" \
    "$HOME/Library/Caches/CocoaPods" \
    "$HOME/Library/Caches/pip" \
    "$HOME/Library/Caches/Homebrew"

  remove_paths 'DerivedData de Xcode' "$HOME/Library/Developer/Xcode/DerivedData"

  CODE_DIR="$HOME/Library/Application Support/Code"
  if [[ -d "$CODE_DIR" ]]; then
    remove_paths 'Cachés y estado de workspaces de VS Code' \
      "$CODE_DIR/Cache" \
      "$CODE_DIR/CachedData" \
      "$CODE_DIR/Code Cache" \
      "$CODE_DIR/GPUCache" \
      "$CODE_DIR/DawnGraphiteCache" \
      "$CODE_DIR/DawnWebGPUCache" \
      "$CODE_DIR/Crashpad" \
      "$CODE_DIR/logs" \
      "$CODE_DIR/Service Worker/CacheStorage" \
      "$CODE_DIR/User/workspaceStorage"
    printf '  %sTus ajustes, atajos y extensiones se conservan.%s\n' "$DIM" "$RESET"
  else
    skip_step 'VS Code'
  fi
fi

AFTER=$(free_gib)
RECOVERED=$(awk -v after="$AFTER" -v before="$BEFORE" 'BEGIN {
  difference=after-before
  if (difference < 0) difference=0
  printf "%.1f", difference
}')

printf '\n'
line
if $DRY_RUN; then
  printf '%s◇ Simulación terminada%s — no se eliminó ningún archivo.\n\n' "$CYAN" "$RESET"
else
  printf '%s✓ Limpieza terminada%s\n\n' "$GREEN" "$RESET"
  printf '  Antes       %s GiB libres\n' "$BEFORE"
  printf '  Después     %s GiB libres\n' "$AFTER"
  printf '  Recuperado  %s%s GiB%s\n\n' "$BOLD" "$RECOVERED" "$RESET"
fi
